PORT=4000
# Where the catalogue lives (Project Settings → API). The publishable/anon key is enough to read it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: persist simulated orders to Supabase. Without these the API keeps orders in memory.
SUPABASE_SERVICE_ROLE_KEY=
# The profile that demo orders belong to (an auth.users id in your project)
DEMO_USER_ID=
