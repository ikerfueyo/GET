{
  "expo": {
    "name": "GET",
    "slug": "get",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.get.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.get.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "get",
    "backgroundColor": "#FFFFFF",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GET uses your location to find the closest, fastest way to get anything."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 110,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2c96f403-f776-4250-b6c6-637972d89a54"
      }
    },
    "owner": "ikerfueyo",
    "runtimeVersion": "exposdk:58.0.0",
    "updates": {
      "url": "https://u.expo.dev/2c96f403-f776-4250-b6c6-637972d89a54"
    }
  }
}
